{
  "name": "instagram-download-browser-extension",
  "version": "2.5.3",
  "description": "",
  "keywords": [
    "Instagram",
    "browser",
    "download",
    "extension"
  ],
  "homepage": "https://github.com/TheKonka/instagram-download-browser-extension",
  "bugs": {
    "url": "https://github.com/TheKonka/instagram-download-browser-extension/issues",
    "email": "1094918@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Konka",
    "email": "1094918@gmail.com"
  },
  "type": "module",
  "scripts": {
    "build:chrome": "npx tsc --noEmit && node esbuild.config.mjs chrome",
    "build:ff": "npx tsc --noEmit && node esbuild.config.mjs firefox",
    "dev:chrome": "npx tsc --noEmit && node esbuild.config.mjs chrome --watch",
    "dev:ff": "npx tsc --noEmit && node esbuild.config.mjs firefox --watch",
    "sign:ff": "pnpm run build:ff && web-ext sign --channel=unlisted --source-dir=dist/firefox --artifacts-dir=web-ext-artifacts",
    "android": "node ./node_modules/web-ext/bin/web-ext.js run -t firefox-android --android-device=5e843fe4 --firefox-apk org.mozilla.fenix --source-dir ./dist/firefox",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.86.0",
    "@types/firefox-webext-browser": "^143.0.0",
    "chrome-types": "^0.1.429",
    "esbuild": "^0.28.0",
    "esbuild-sass-plugin": "^3.7.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "web-ext": "^10.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
