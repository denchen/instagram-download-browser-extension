{
  "name": "instagram-download-browser-extension",
  "version": "2.8.0",
  "description": "",
  "keywords": [
    "Instagram",
    "browser",
    "download",
    "extension"
  ],
  "homepage": "https://github.com/denchen/instagram-download-browser-extension",
  "bugs": {
    "url": "https://github.com/denchen/instagram-download-browser-extension/issues",
    "email": "denchen@yahoo.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Dennis Chen",
    "email": "denchen@yahoo.com"
  },
  "type": "module",
  "scripts": {
    "build:chrome": "npx tsc --noEmit && node esbuild.config.mjs chrome",
    "build:ff": "npx tsc --noEmit && node esbuild.config.mjs firefox",
    "dev:chrome": "npx tsc --noEmit && node esbuild.config.mjs chrome --watch",
    "dev:ff": "npx tsc --noEmit && node esbuild.config.mjs firefox --watch",
    "sign:ff": "pnpm run build:ff && web-ext sign --channel=unlisted --source-dir=dist/firefox --artifacts-dir=web-ext-artifacts",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "mediabunny": "1.62.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/firefox-webext-browser": "^143.0.1",
    "chrome-types": "^0.1.457",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sass-embedded": "^1.106.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
