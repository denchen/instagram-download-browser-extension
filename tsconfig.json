{
  "compilerOptions": {
    "strict": true,
    "module": "preserve",
    "noEmit": true,
    "target": "ESNext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["chrome-types", "firefox-webext-browser"]
  },
  "exclude": ["node_modules", "public", "dist"]
}
